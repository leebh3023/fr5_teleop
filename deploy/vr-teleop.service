[Unit]
Description=Quest WebXR to Fairino FR5 teleop bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vr-teleop
Group=vr-teleop
WorkingDirectory=/opt/vr-teleop
ExecStart=/opt/vr-teleop/.venv-linux/bin/python -m teleop --config /etc/vr-teleop/config.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
